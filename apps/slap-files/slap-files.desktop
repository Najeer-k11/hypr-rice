[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Slap File Manager — browse, copy, eject drives
Exec=slap-files %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
Keywords=files;folders;explorer;drive;trash;
StartupWMClass=slap.files
