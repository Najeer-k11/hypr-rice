#!/usr/bin/env python3
"""lyra — waybar music module + floating player popup (album art + controls).

  lyra bar      waybar custom module: streams JSON whenever the player changes
  lyra toggle   open the popup, or close it if it's already open
"""
import html
import json
import os
import re
import sys
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path

# GL renderer: GTK4's Vulkan default wakes the suspended NVIDIA dGPU (~2 s open delay).
os.environ.setdefault("GSK_RENDERER", "gl")
# The desktop portal check costs ~420 ms of GTK startup, and nothing here uses portals.
os.environ.setdefault("GDK_DEBUG", "no-portals")
import gi

gi.require_version("Playerctl", "2.0")
from gi.repository import GLib, Playerctl  # noqa: E402

APP_ID = "rice.lyra"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "lyra"
COLORS = Path.home() / ".config/waybar/colors.css"
CLOSED_STAMP = RUNTIME / "lyra-closed"
UA = "lyra-music/0.1 (personal waybar player)"


# ───────────────────────────────────────────────────────────── players ────
class Players:
    """Tracks MPRIS players and picks the one that matters (playing > most recent)."""

    def __init__(self, on_change):
        self.on_change = on_change
        self.mgr = Playerctl.PlayerManager()
        self.mgr.connect("name-appeared", lambda _m, n: self._add(n))
        self.mgr.connect("player-vanished", lambda *_: self.on_change())
        for n in self.mgr.props.player_names:
            self._add(n, notify=False)

    def _add(self, name, notify=True):
        p = Playerctl.Player.new_from_name(name)
        for sig in ("metadata", "playback-status", "loop-status", "shuffle", "seeked"):
            p.connect(sig, lambda *_: self.on_change())
        self.mgr.manage_player(p)
        if notify:
            self.on_change()

    def current(self):
        ps = list(self.mgr.props.players)
        for p in ps:
            if p.props.playback_status == Playerctl.PlaybackStatus.PLAYING:
                return p
        return ps[0] if ps else None


def meta(p, key):
    try:
        return p.print_metadata_prop(key) or ""
    except GLib.Error:
        return ""


def track_info(p):
    try:
        length = int(meta(p, "mpris:length") or 0) / 1e6
    except ValueError:
        length = 0
    return {
        "title": meta(p, "xesam:title") or "unknown",
        "artist": meta(p, "xesam:artist"),
        "album": meta(p, "xesam:album"),
        "art": meta(p, "mpris:artUrl"),
        "url": meta(p, "xesam:url"),
        "length": length,
        "playing": p.props.playback_status == Playerctl.PlaybackStatus.PLAYING,
        "player": p.props.player_name,
    }


def position(p):
    try:
        return p.get_position() / 1e6
    except GLib.Error:
        return 0.0


# ───────────────────────────────────────────────────────────── bar mode ───
def run_bar():
    last = [None]

    def emit():
        p = players.current()
        if not p:
            out = {"text": "", "class": "stopped"}
        else:
            t = track_info(p)
            icon = "󰐊" if t["playing"] else "󰏤"
            out = {
                "text": f"<span font_family='GeistMono Nerd Font Propo' font_size='10.5pt'>{icon}</span>  " + html.escape(t['title']),
                "tooltip": html.escape(" — ".join(x for x in (t["artist"], t["title"]) if x)),
                "class": "playing" if t["playing"] else "paused",
                "alt": t["player"],
            }
        s = json.dumps(out)
        if s != last[0]:
            last[0] = s
            print(s, flush=True)

    players = Players(lambda: GLib.idle_add(emit) and None)
    emit()
    GLib.MainLoop().run()


def fetch_art(url):
    if url.startswith("file://"):
        return urllib.parse.unquote(url[7:])
    if url.startswith("http"):
        dest = CACHE / "art" / re.sub(r"[^\w.-]+", "_", url)[-120:]
        if not dest.is_file():
            dest.parent.mkdir(parents=True, exist_ok=True)
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=8) as r:
                dest.write_bytes(r.read())
        return str(dest)
    return None


# ───────────────────────────────────────────────────────────── popup ──────
CSS = """
window.lyra { background: @surface; border-radius: 10px; }
.lyra-root { padding: 14px; }
.art-frame { border-radius: 8px; background: @surface_container_high; }
.art-empty { color: @outline; font-size: 48px; }
.title  { font-weight: 700; font-size: 15px; color: @on_surface; }
.sub    { color: @on_surface_variant; font-size: 12px; }
.time   { color: @outline; font-size: 11px; font-feature-settings: "tnum"; }
scale trough { background: @surface_container_highest; min-height: 4px; border-radius: 2px; }
scale highlight { background: @primary; border-radius: 2px; }
scale slider { background: @primary; min-width: 12px; min-height: 12px; margin: -5px; border-radius: 99px; box-shadow: none; }
button.ctl { font-family: "GeistMono Nerd Font"; background: transparent; color: @on_surface_variant; border-radius: 99px;
             min-width: 36px; min-height: 36px; padding: 0; box-shadow: none; border: none; }
button.ctl:hover { background: @surface_container_high; color: @on_surface; }
button.ctl.on { color: @primary; }
button.play { background: @primary; color: @on_primary; min-width: 48px; min-height: 48px; font-size: 18px; }
button.play:hover { background: @primary_container; color: @on_primary_container; }
"""


def run_popup():
    # the click that just closed us via focus-loss must not reopen us
    try:
        if time.time() - float(CLOSED_STAMP.read_text()) < 0.4:
            return
    except (OSError, ValueError):
        pass

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, Gtk, Pango

    app = Gtk.Application(application_id=APP_ID)
    state = {"win": None}

    def activate(app):
        if state["win"]:  # second `lyra toggle` → close
            app.quit()
            return
        state["win"] = Popup(app, Gtk, Gdk, Pango)

    app.connect("activate", activate)
    app.run([])


class Popup:
    ART = 168      # album art side
    MID = 260      # info + controls column

    def __init__(self, app, Gtk, Gdk, Pango):
        self.Gtk, self.Gdk = Gtk, Gdk
        self.track_key = None

        prov = Gtk.CssProvider()
        colors = COLORS.read_text() if COLORS.is_file() else ""
        prov.load_from_string(colors + CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        win = self.win = Gtk.ApplicationWindow(application=app, title="lyra")
        win.add_css_class("lyra")
        win.set_decorated(False)
        win.set_resizable(False)

        # [ art ] [ title / progress / controls ]
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        root.add_css_class("lyra-root")
        win.set_child(root)

        def label(cls):
            lb = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            lb.add_css_class(cls)
            return lb

        # album art
        self.art_frame = Gtk.Overlay(valign=Gtk.Align.CENTER)
        self.art_frame.add_css_class("art-frame")
        self.art_frame.set_overflow(Gtk.Overflow.HIDDEN)
        self.art_frame.set_size_request(self.ART, self.ART)
        empty = Gtk.Label(label="󰎈")
        empty.add_css_class("art-empty")
        self.art_frame.set_child(empty)
        self.art = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        self.art_frame.add_overlay(self.art)
        root.append(self.art_frame)

        # middle column
        mid_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.CENTER)
        mid_col.set_size_request(self.MID, -1)
        root.append(mid_col)

        self.title, self.sub = label("title"), label("sub")
        tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        tbox.append(self.title)
        tbox.append(self.sub)
        mid_col.append(tbox)

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.scale.set_draw_value(False)
        self.scale.connect("change-value", self.on_seek)
        self.t_pos, self.t_len = label("time"), label("time")
        self.t_len.set_xalign(1)
        times = Gtk.Box(homogeneous=True)
        times.append(self.t_pos)
        times.append(self.t_len)
        pbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=4)
        pbox.append(self.scale)
        pbox.append(times)
        mid_col.append(pbox)

        def btn(icon, cb, *cls):
            b = Gtk.Button(label=icon, valign=Gtk.Align.CENTER)
            b.add_css_class("ctl")
            for c in cls:
                b.add_css_class(c)
            b.connect("clicked", lambda *_: self.act(cb))
            return b
        self.b_shuffle = btn("󰒟", lambda p: p.set_shuffle(not p.props.shuffle))
        self.b_play = btn("󰐊", lambda p: p.play_pause(), "play")
        self.b_loop = btn("󰑖", self.cycle_loop)
        ctl = Gtk.CenterBox()
        left = Gtk.Box(spacing=4)
        right = Gtk.Box(spacing=4)
        left.append(self.b_shuffle)
        left.append(btn("󰒮", lambda p: p.previous()))
        right.append(btn("󰒭", lambda p: p.next()))
        right.append(self.b_loop)
        ctl.set_start_widget(left)
        ctl.set_center_widget(self.b_play)
        ctl.set_end_widget(right)
        mid_col.append(ctl)

        # close on Esc / focus loss
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_: kv == Gdk.KEY_Escape and self.close())
        win.add_controller(keys)
        win.connect("notify::is-active", self.on_active)

        self.players = Players(lambda: GLib.idle_add(self.refresh) and None)
        self.refresh()
        GLib.timeout_add(250, self.tick)
        win.present()

    # ── actions
    def act(self, fn):
        p = self.players.current()
        if p:
            try:
                fn(p)
            except GLib.Error:
                pass

    @staticmethod
    def cycle_loop(p):
        L = Playerctl.LoopStatus
        nxt = {L.NONE: L.PLAYLIST, L.PLAYLIST: L.TRACK, L.TRACK: L.NONE}
        p.set_loop_status(nxt.get(p.props.loop_status, L.NONE))

    def on_seek(self, _scale, _scroll, value):
        self.act(lambda p: p.set_position(int(value * 1e6)))
        return False

    def on_active(self, win, _pspec):
        if not win.is_active():
            self._seen_active and self.close()
        else:
            self._seen_active = True

    _seen_active = False

    def close(self):
        CLOSED_STAMP.write_text(str(time.time()))
        self.win.get_application().quit()

    # ── state → UI
    def refresh(self):
        p = self.players.current()
        if not p:
            self.title.set_label("nothing playing")
            self.sub.set_label("start a player — spotify, mpv, a browser tab…")
            self.art.set_paintable(None)
            self.track_key = None
            return
        t = track_info(p)
        self.title.set_label(t["title"])
        self.sub.set_label(" · ".join(x for x in (t["artist"], t["album"]) if x) or t["player"])
        self.b_play.set_label("󰏤" if t["playing"] else "󰐊")
        self.length = t["length"]
        self.scale.set_range(0, max(t["length"], 1))
        self.t_len.set_label(fmt(t["length"]))

        for b, on in ((self.b_shuffle, self._get(p, "shuffle")),
                      (self.b_loop, self._get(p, "loop_status") not in (None, Playerctl.LoopStatus.NONE))):
            (b.add_css_class if on else b.remove_css_class)("on")
        if self._get(p, "loop_status") == Playerctl.LoopStatus.TRACK:
            self.b_loop.set_label("󰑘")
        else:
            self.b_loop.set_label("󰑖")

        key = (t["artist"], t["title"], t["art"])
        if key != self.track_key:
            self.track_key = key
            self.load_track(t)
        self.tick(once=True)

    @staticmethod
    def _get(p, prop):
        try:
            return p.get_property(prop)
        except Exception:
            return None

    def load_track(self, t):
        key = self.track_key
        self.art.set_paintable(None)

        def work():
            try:
                path = fetch_art(t["art"])
            except Exception:
                path = None
            GLib.idle_add(self._set_art, key, path)
        threading.Thread(target=work, daemon=True).start()

    def _set_art(self, key, path):
        if key == self.track_key and path:
            try:
                self.art.set_paintable(self.Gdk.Texture.new_from_filename(path))
            except GLib.Error:
                pass

    def tick(self, once=False):
        p = self.players.current()
        if p:
            pos = position(p)
            self.scale.set_value(pos)
            self.t_pos.set_label(fmt(pos))
        return once is False  # keep the 250ms timer alive



def fmt(sec):
    sec = int(sec or 0)
    return f"{sec // 60}:{sec % 60:02d}"


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if cmd == "bar":
        run_bar()
    elif cmd in ("toggle", "popup"):
        run_popup()
    else:
        sys.exit(__doc__)
