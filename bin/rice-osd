#!/usr/bin/env bash
# rice-osd vol up|down|mute  /  bri up|down — changes value, shows a replacing notification with a bar
# Serialise key repeats so the popup always ends on the latest value.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/rice-osd.lock"
flock 9
show() { # title value icon
    notify-send -a osd -t 1100 -h "int:value:$2" -h string:x-canonical-private-synchronous:rice-osd -i "$3" "$1" "$2%"
}
case "$1 $2" in
    "vol up")   wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    "vol down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    "vol mute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    "bri up")   brightnessctl -q -e4 -n2 set 5%+ ;;
    "bri down") brightnessctl -q -e4 -n2 set 5%- ;;
esac
case "$1" in
    vol) v="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"; pct="$(awk '{printf "%d", $2*100}' <<<"$v")"
         if [[ "$v" == *MUTED* ]]; then show "Muted" "$pct" audio-volume-muted
         else show "Volume" "$pct" audio-volume-high; fi ;;
    bri) pct="$(brightnessctl -m | cut -d, -f4 | tr -d %)"; show "Brightness" "$pct" display-brightness ;;
esac
