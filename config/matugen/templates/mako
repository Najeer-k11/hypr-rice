# generated by matugen — edit ~/.config/matugen/templates/mako instead
font=GeistMono Nerd Font 10.5
anchor=top-right
outer-margin=6,6,0,0
margin=6
padding=12,14
width=340
max-icon-size=40
icon-path=/usr/share/icons/Papirus-Dark
border-size=1
border-radius=6
default-timeout=5000
max-history=30
max-visible=4
layer=overlay
background-color={{colors.surface_container.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-color={{colors.outline_variant.default.hex}}
progress-color=over {{colors.primary_container.default.hex}}
format=<b>%s</b>\n%b

[urgency=high]
border-color={{colors.error.default.hex}}
default-timeout=0

[app-name=osd]
anchor=bottom-center
outer-margin=0,0,48,0
width=260
format=<b>%s</b>  %b
max-icon-size=24

[mode=do-not-disturb]
invisible=1
[mode=do-not-disturb app-name=osd]
invisible=0
