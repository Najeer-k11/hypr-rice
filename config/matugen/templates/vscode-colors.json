  "editor.tokenColorCustomizations": {
    "comments": "{{colors.outline.default.hex}}",
    "keywords": "{{colors.primary.default.hex}}",
    "strings": "{{colors.green.default.hex}}",
    "numbers": "{{colors.yellow.default.hex}}",
    "functions": "{{colors.blue.default.hex}}",
    "types": "{{colors.tertiary.default.hex}}",
    "variables": "{{colors.on_surface.default.hex}}",
    "textMateRules": [
      { "scope": ["storage", "storage.type", "storage.modifier"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
      { "scope": ["constant.language", "constant.character", "support.constant"], "settings": { "foreground": "{{colors.yellow.default.hex}}" } },
      { "scope": ["variable.parameter"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}", "fontStyle": "italic" } },
      { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "{{colors.red.default.hex}}" } },
      { "scope": ["entity.other.attribute-name", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
      { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
      { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "{{colors.cyan.default.hex}}" } },
      { "scope": ["variable.language", "support.variable"], "settings": { "foreground": "{{colors.magenta.default.hex}}" } },
      { "scope": ["markup.heading"], "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" } },
      { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "{{colors.green.default.hex}}" } }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "keyword": "{{colors.primary.default.hex}}",
      "function": "{{colors.blue.default.hex}}",
      "method": "{{colors.blue.default.hex}}",
      "class": "{{colors.tertiary.default.hex}}",
      "type": "{{colors.tertiary.default.hex}}",
      "interface": "{{colors.tertiary.default.hex}}",
      "enum": "{{colors.tertiary.default.hex}}",
      "enumMember": "{{colors.yellow.default.hex}}",
      "property": "{{colors.secondary.default.hex}}",
      "parameter": { "foreground": "{{colors.on_surface_variant.default.hex}}", "italic": true },
      "namespace": "{{colors.cyan.default.hex}}",
      "macro": "{{colors.magenta.default.hex}}"
    }
  }
}
