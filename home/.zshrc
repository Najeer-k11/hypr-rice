# ──────────────────────────────────────────────
#   ~/.zshrc
#   Colors come from kitty's palette (generated by matugen),
#   so the prompt follows your wallpaper automatically.
# ──────────────────────────────────────────────

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim

# ── History ──────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# ── Behaviour ────────────────────────────────
setopt AUTO_CD INTERACTIVE_COMMENTS PROMPT_SUBST NO_BEEP

# ── Completion ───────────────────────────────
autoload -Uz compinit && compinit -d ~/.cache/zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'          # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── Keys (emacs-style + arrows search history by prefix) ──
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# ── Git branch in prompt ─────────────────────
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{5} %b%f'
precmd() { vcs_info; [[ -n $_first_prompt_done ]] && print ""; _first_prompt_done=1 }  # blank line between commands (not before first prompt)

# ── Prompt ───────────────────────────────────
#   ╭─ you@archlinux  ~/.config  main
#   ╰─❯
PROMPT='%F{8}╭─%f %B%F{4}%n%f%b%F{8}@%f%F{6}%m%f  %B%F{15}%~%f%b${vcs_info_msg_0_}
%F{8}╰─%f%(?.%F{4}.%F{1})❯%f '
RPROMPT='%(?..%F{1}✘ %?%f)'

# ── Aliases ──────────────────────────────────
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias grep='grep --color=auto'
alias ..='cd ..'
